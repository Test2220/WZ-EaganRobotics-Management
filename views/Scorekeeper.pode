<html>
<head>

    <link rel="stylesheet" href="/styles/style.css" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

 <script type="application/javascript">

    
    function PlaylistChange (fieldID){

    // Creating a XHR object
    let xhr = new XMLHttpRequest();
    let url = "/api/arena/scorekeeper";
    // Converting JSON data to string

        var data = JSON.stringify({"element": fieldID});

    // open a connection
    xhr.open("POST", url, true);

    // Set the request header i.e. which type of content you are sending
    xhr.setRequestHeader("Content-Type", "application/json");
    

    // Sending data with the request
    xhr.send(data);
}

var getJSON = function(url, callback) {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.responseType = 'json';
    xhr.onload = function() {
      var status = xhr.status;
      if (status === 200) {
        callback(null, xhr.response);
      } else {
        callback(status, xhr.response);
      }
    };
    xhr.send();
};

</script>
</head>
<body>
<div id="mainview">
<div id="redContainer">
<table id="redTowerTable">
  <tr><td colspan="4">Red L1 Auto</td></tr>
  <tr>  
    <td><button id="redautoL1-0" type="button" onclick="PlaylistChange(this.id)">0</button></td>
    <td><button id="redautoL1-1" type="button" onclick="PlaylistChange(this.id)">1</button></td>
    <td><button id="redautoL1-2" type="button" onclick="PlaylistChange(this.id)">2</button></td>
  </tr>
  <tr><td colspan="4">Level 1</td></tr>
    <tr>  
    <td><button id="redteleL1-0" type="button" onclick="PlaylistChange(this.id)">0</button></td>
    <td><button id="redteleL1-1" type="button" onclick="PlaylistChange(this.id)">1</button></td>
    <td><button id="redteleL1-2" type="button" onclick="PlaylistChange(this.id)">2</button></td>
    <td><button id="redteleL1-3" type="button" onclick="PlaylistChange(this.id)">3</button></td>
  </tr>  <tr><td colspan="4">Level 2</td></tr>
    <tr>  
    <td><button id="redteleL2-0" type="button" onclick="PlaylistChange(this.id)">0</button></td>
    <td><button id="redteleL2-1" type="button" onclick="PlaylistChange(this.id)">1</button></td>
