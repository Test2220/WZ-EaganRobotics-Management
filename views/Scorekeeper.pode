<html>
<head>

    <link rel="stylesheet" href="/styles/style.css" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

 <script type="application/javascript">

    
    function PlaylistChange (fieldID){

    // Creating a XHR object
    let xhr = new XMLHttpRequest();
    let url = "/api/arena/scorekeeper";
    // Converting JSON data to string

        var data = JSON.stringify({"element": fieldID});

    // open a connection
    xhr.open("POST", url, true);

    // Set the request header i.e. which type of content you are sending
    xhr.setRequestHeader("Content-Type", "application/json");
    

    // Sending data with the request
    xhr.send(data);
}

var getJSON = function(url, callback) {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url, true);
    xhr.responseType = 'json';
    xhr.onload = function() {
      var status = xhr.status;
      if (status === 200) {
        callback(null, xhr.response);
      } else {
        callback(status, xhr.response);
      }
    };
    xhr.send();
};

</script>
</head>
<body>
<div id="mainview">
<div id="redContainer">
  <button id="redautoL1Add" type="button" onclick="PlaylistChange(this.id)">Auto +</button>
  <button id="redteleL1Add" type="button" onclick="PlaylistChange(this.id)">Tele +</button>
  Level 1
  <button id="redteleL1Sub" type="button" onclick="PlaylistChange(this.id)">Tele -</button>
  <button id="redAutoL1Sub" type="button" onclick="PlaylistChange(this.id)">Auto -</button>

  <button id="redteleL2Add" type="button" onclick="PlaylistChange(this.id)">+</button>
  Level 2
  <button id="redteleL2Sub" type="button" onclick="PlaylistChange(this.id)">-</button>

  <button id="redteleL3Add" type="button" onclick="PlaylistChange(this.id)">+</button>
  Level 3
  <button id="redteleL3Sub" type="button" onclick="PlaylistChange(this.id)">-</button>

</div>

<div id="blueContainer">
<button id="blueautoL1Add" type="button" onclick="PlaylistChange(this.id)">Auto +</button>
<button id="blueteleL1Add" type="button" onclick="PlaylistChange(this.id)">Tele +</button>
Level 1
<button id="blueteleL1Sub" type="button" onclick="PlaylistChange(this.id)">Tele -</button>
<button id="blueautoL1Sub" type="button" onclick="PlaylistChange(this.id)">Auto -</button>

<button id="blueteleL2Add" type="button" onclick="PlaylistChange(this.id)">+</button>
Level 2
<button id="blueteleL2Sub" type="button" onclick="PlaylistChange(this.id)">-</button>

<button id="blueteleL3Add" type="button" onclick="PlaylistChange(this.id)">+</button>
Level 3
<button id="blueteleL3Sub" type="button" onclick="PlaylistChange(this.id)">-</button>
</div>

<div id="ScoreStats">


</div>

</div>
</body>
</html>