    <td><button id="redteleL3-1" type="button" onclick="PlaylistChange(this.id)">1</button></td>
    <td><button id="redteleL3-2" type="button" onclick="PlaylistChange(this.id)">2</button></td>
    <td><button id="redteleL3-3" type="button" onclick="PlaylistChange(this.id)">3</button></td>
  </tr>
  </table
</div>

<div id="blueContainer">
<table id="blueTowerTable">
