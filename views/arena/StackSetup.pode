<html>
<head>

    <link rel="stylesheet" href="style.css" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
</head>
<body>
<div id="mainview">
<form action="/api/arena/StackSetup" id="StacklightConfig" method="post">
<h2>Manual add</h2>
    <div class="form-row'>
        <label for="BlueSCC">BlueSCC</label>
        <input type="text" class="input-text input-text-block" id="BlueSCCIP" name="BlueSCC" value=$($data.BlueSCC;) />
    </div>
    <div class="form-row'>
        <label for="RedSCC">RedSCC</label>
        <input type="text" class="input-text input-text-block" id="RedSCCIP" name="RedSCC" value=$($data.RedSCC;) />
    </div>
        <div class="form-row'>
        <label for="MiddleStack">MiddleStack</label>
        <input type="text" class="input-text input-text-block" id="MiddleStackIP" name="MiddleStack" value=$($data.MiddleStack;) />
    </div>
    <div class="form-row mx-auto">
        <input type="submit" class="btn-submit" id="btn-submit" />
    </div>


</form>
</div>
</body>
</html>